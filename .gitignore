# Rendered output
# NOTE: *.html is commented out — stack is undecided (Dash vs static-HTML
# pattern). If we ship a hand-authored static front end, source .html must
# be tracked. Re-enable this only if switching to a Quarto/R render pipeline.
# *.html
_freeze/
_site/

# R
.Rproj.user/
.Rhistory
.RData
.Rdata
renv/library/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / SvelteKit
node_modules/
/build
/.svelte-kit
/package-lock.json.bak

# Engagement deploy-guard: client mode is runtime-only, never committed/deployed.
# Demo/example configs (engagement.demo.yml, engagement.example.yml) stay committable.
client-data/
client-output/
engagement.yml
engagement.yaml

# Environment and secrets
.env
*.env
*.key
credentials.*

# Data files (uncomment if needed)
# *.db
# *.sqlite
# data/raw/

# Local Claude tooling — regenerable from the workflow-package; kept OUT of the
# repo (decision, wrap 2026-08-26). Made explicit here so it doesn't depend on a
# machine's global gitignore. Force-add later if project commands should travel.
.claude/

# OS
.DS_Store
Thumbs.db
